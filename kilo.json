{
  "$schema": "https://app.kilo.ai/config.json",
  "skills": {
    "paths": [".kilo/skills"]
  },
  "permission": {
    "*": "ask",
    "bash": "ask"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "claude-flow": {
      "type": "local",
      "command": ["npx", "-y", "@claude-flow/cli@latest", "mcp", "start"],
      "enabled": true
    }
  },
  "agent": {
    "code": {
      "permission": {
        "bash": "ask"
      }
    },
    "general": {
      "permission": {
        "bash": "ask"
      }
    },
    "debug": {
      "permission": {
        "bash": "ask"
      }
    },
    "plan": {
      "permission": {
        "bash": "ask"
      }
    },
    "build": {
      "permission": {
        "bash": "ask"
      }
    },
    "mansoni": {
      "permission": {
        "bash": "ask"
      }
    }
  }
}
