{
  "hooks": {
    "memoryBeforeRead": "cat .claude/helpers/workflow-context.cjs | node - infer \"$QUERY\"",
    "memoryAfterWrite": "cat .claude/helpers/workflow-context.cjs | node - task-intent post \"$QUERY\"",
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(python3 -c \"import json,sys; d=json.load(sys.stdin); print(d.get('tool_input',d).get('command',''))\" 2>/dev/null || true); case \"$CMD\" in *grep*|*rg\\ *|*ripgrep*|*find\\ *|*fd\\ *|*ack\\ *|*ag\\ *)   [ -f graphify-out/graph.json ] &&   echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: knowledge graph at graphify-out/. For focused questions, run `graphify query \\\"<question>\\\"` (scoped subgraph, usually much smaller than GRAPH_REPORT.md) instead of grepping raw files. Read GRAPH_REPORT.md only for broad architecture context.\"}}'   || true ;; esac"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/error-capture.sh"
          },
          {
            "type": "command",
            "command": "bash .github/hooks/success-capture.sh"
          }
        ]
      }
    ]
  },
  "allowedTools": {
    "bash": [
      "*"
    ],
    "read": [],
    "edit": [],
    "write": [],
    "grep": [],
    "glob": []
  },
  "model": "sonnet-4-6",
  "availableModels": ["opus", "opus-4-8", "opus-4-7", "sonnet", "sonnet-4-6", "haiku", "fable"],
  "fallbackModel": ["opus-4-8", "opus", "sonnet"],
  "skills": {
    "enabled": [
      "hooks-automation",
      "pair-programming",
      "skill-builder",
      "sparc-methodology",
      "stream-chain",
      "swarm-advanced",
      "swarm-orchestration",
      "verification-quality",
      "browser",
      "ui-test",
      "autobrowse",
      "browser-trace",
      "safe-browser",
      "cookie-sync",
      "browser-to-api",
      "browserbase-cli",
      "functions",
      "search",
      "fetch",
      "agent-experience",
      "company-research",
      "event-prospecting",
      "mansoni-learn",
      "baoyu-design",
      "nothing-design",
      "design-taste-frontend",
      "frontend-design",
      "shadcn-ui",
      "color-expert",
      "creative-director",
      "ui-ux-pro-max",
      "apple-hig",
      "design-review",
      "minimalist-ui",
      "industrial-brutalist-ui",
      "gsap-core",
      "gsap-scrolltrigger",
      "threejs",
      "remotion",
      "figma-implement-design",
      "imagegen",
      "canvas-design"
    ],
    "defaultWorkflow": "general",
    "namespace": "mansoni-swarm",
    "runtime": "ruflo"
  },
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp"],
      "env": {},
      "tools": [
        "browser_navigate",
        "browser_snapshot",
        "browser_click",
        "browser_type",
        "browser_fill_form",
        "browser_select_option",
        "browser_hover",
        "browser_evaluate",
        "browser_press_key",
        "browser_take_screenshot",
        "browser_console_messages",
        "browser_network_requests",
        "browser_network_request"
      ]
    }
  },
  "workflows": {
    "autoRoute": true,
    "default": "general",
    "contractsPath": ".claude/contracts/mansoni-workflows.json"
  },
  "verification": {
    "gates": {
      "tsc": true,
      "tests": false,
      "lint": false,
      "review": true
    }
  },
  "memory": {
    "autoSync": true,
    "projectPath": "memories/repo"
  }
}