{
  "hooks": {
    "memoryBeforeRead": "cat .claude/helpers/workflow-context.cjs | node - infer \"$QUERY\"",
    "memoryAfterWrite": "cat .claude/helpers/workflow-context.cjs | node - task-intent post \"$QUERY\""
  },
  "allowedTools": {
    "bash": ["node --version", "npm --version", "npx vitest", "npx playwright"],
    "read": [],
    "edit": [],
    "write": [],
    "grep": [],
    "glob": []
  },
  "skills": {
    "enabled": [
      "hooks-automation",
      "pair-programming",
      "skill-builder",
      "sparc-methodology",
      "stream-chain",
      "swarm-advanced",
      "swarm-orchestration",
      "verification-quality"
    ],
    "defaultWorkflow": "general",
    "namespace": "mansoni-swarm",
    "runtime": "ruflo"
  },
  "workflows": {
    "autoRoute": true,
    "default": "general",
    "contractsPath": ".claude/contracts/mansoni-workflows.json"
  },
  "verification": {
    "gates": {
      "tsc": true,
      "tests": false,
      "lint": false,
      "review": true
    }
  },
  "memory": {
    "autoSync": true,
    "projectPath": "memories/repo"
  }
}
